# ─── Local Development Environment ───────────────────────────────────────────
# Copy this file to .env and fill in your real values before running the server.

NODE_ENV=local
PORT=3000

# PostgreSQL connection string
# For local dev: create a database called 'budget_tracker_dev'
# Example using Docker: docker run -e POSTGRES_PASSWORD=password -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:password@localhost:5432/budget_tracker_dev

# JWT secrets — must be 32+ characters each
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_a_secure_random_string_min_32_chars_dev
JWT_REFRESH_SECRET=change_this_to_another_secure_random_string_min_32_chars_dev

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# CORS — set to the Flutter web origin if using web build
CORS_ORIGINS=http://localhost:3000

# Redis (optional — used for distributed rate limiting in production)
# REDIS_URL=redis://localhost:6379

# Sentry (optional — for error tracking in staging/production)
# SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
