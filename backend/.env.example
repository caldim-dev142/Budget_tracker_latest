# ─── BudgetIQ Backend — Environment Configuration Template ───────────────────
# Copy this file to .env and fill in REAL values before starting the server.
#
# CRITICAL SECURITY RULES:
#   1. NEVER commit .env to version control. It is listed in .gitignore.
#   2. NEVER use the placeholder values below in production.
#   3. JWT secrets MUST be randomly generated — see commands below.
#   4. CORS_ORIGINS MUST be set to only your approved domains in production.

NODE_ENV=local
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
# For local dev: docker run -e POSTGRES_PASSWORD=password -p 5432:5432 postgres:16
#
# Supabase Pooler & Connection Pool Sizing Tradeoff:
# - Port 5432 (Session Mode):
#   Prisma interactive transactions ($transaction(async (tx) => ...)), prepared
#   statements, advisory locks, and temporary tables require session mode.
# - DO NOT use port 6543 / pgbouncer=true (Transaction Mode):
#   Supabase transaction pooling swaps underlying connections per query, which
#   breaks Prisma interactive multi-query transactions (e.g., wallet/sync updates).
# - connection_limit=10:
#   Sets Prisma's internal connection pool limit to 10 connections. This is sized to
#   support expected concurrent sync batches without exhausting Supabase pooler limits
#   (typically 15 concurrent sessions on Supabase free tier).
#
# Local dev:
DATABASE_URL=postgresql://postgres:password@localhost:5432/budget_tracker_dev?connection_limit=10
# Supabase Session Pooler Example:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:5432/postgres?connection_limit=10

# ─── JWT Secrets (REQUIRED — MUST REPLACE WITH RANDOM VALUES) ────────────────
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Run this command TWICE — use one value for ACCESS, one for REFRESH.
# These placeholder values are INSECURE and will NOT be accepted in production.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_HEX_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX_MIN_32_CHARS

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Development: not used (all origins allowed for LAN mobile testing).
# Production: comma-separated list of approved frontend origins.
# Example: CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ─── Security switches ───────────────────────────────────────────────────────
# Each is independent on purpose: previously CORS, Swagger and verbose errors
# were all gated on NODE_ENV alone, so one forgotten variable opened all three.

# Allow ANY origin with credentials. Development only — ignored in production.
CORS_ALLOW_ALL=false

# Serve Swagger at /api/docs. Defaults: on outside production, off in production.
# ENABLE_SWAGGER=false

# Set true ONLY when behind a reverse proxy you control (Nginx, load balancer),
# so rate limiting sees the real client IP instead of the proxy's.
# Trusting X-Forwarded-For on a directly-exposed server lets clients spoof their
# IP and bypass the throttler.
TRUST_PROXY=false

# ─── Firebase Admin SDK (required for Google Sign-In) ────────────────────────
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key with literal \n characters (NOT actual newlines):
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Google Sign-In: accepted OAuth client IDs ───────────────────────────────
# SECURITY: comma-separated allow-list of YOUR OWN OAuth client IDs. Used to pin
# the `aud` claim when a client sends a direct Google ID token instead of a
# Firebase one. If this is left empty that fallback is DISABLED (fail closed) —
# verifying a Google ID token without pinning the audience would accept tokens
# minted for any unrelated application and allow account takeover.
# Find these in android/app/google-services.json > client > oauth_client > client_id
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# ─── Optional: Redis (distributed rate limiting in production) ────────────────
# REDIS_URL=redis://localhost:6379

# ─── Optional: Sentry (error tracking in staging/production) ─────────────────
# If SENTRY_DSN is unset or blank, Sentry cleanly no-ops (safe for local dev and CI).
# When set, unhandled errors (5xx) are automatically reported.
# Sensitive data (request payloads, tokens, passwords, financial amounts/balances)
# is scrubbed before transmission.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# ─── Optional: Logging ───────────────────────────────────────────────────────
# Log level: fatal, error, warn, info, debug, trace. Defaults to 'debug' in development, 'info' in production.
# LOG_LEVEL=

# ─── Optional: Background Cleanup Jobs ───────────────────────────────────────
# Retention window in days for sync tombstones (deleted record markers). Defaults to 90.
# Trade-off: Lower values reduce database size and /sync/pull latency.
# However, a device offline longer than this window may fail to learn about deleted
# records and could potentially re-introduce them on its next sync.
# SYNC_TOMBSTONE_RETENTION_DAYS=90