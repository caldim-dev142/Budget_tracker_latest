generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("households")
}

model User {
  id            String   @id @default(uuid())
  email         String
  password      String?
  displayName   String   @map("display_name")
  household_id  String?
  auth_provider String   @default("email")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

model Category {
  id          String    @id
  householdId String    @map("household_id")
  kind        String
  groupCode   String?   @map("group_code")
  name        String
  needOrWant  String?   @map("need_or_want")
  isDeduction Boolean   @default(false) @map("is_deduction")
  isSystem    Boolean   @default(false) @map("is_system")
  sortOrder   Int       @default(0) @map("sort_order")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  budgets     Budget[]
  entries     Entry[]

  @@map("categories")
}

model Account {
  id                  String  @id @default(uuid())
  householdId         String  @map("household_id")
  name                String
  type                String
  currentBalancePaise Int     @default(0) @map("current_balance_paise")
  isActive            Boolean @default(true) @map("is_active")
  sortOrder           Int     @default(0) @map("sort_order")

  @@map("accounts")
}

model Entry {
  id          String    @id
  householdId String    @map("household_id")
  categoryId  String    @map("category_id")
  kind        String
  accountId   String?   @map("account_id")
  cardId      String?   @map("card_id")
  entryDate   DateTime  @map("entry_date") @db.Timestamptz(6)
  amountPaise Int       @map("amount_paise")
  note        String?
  parentId    String?   @map("parent_id")
  createdBy   String    @map("created_by")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("entries")
}

model Budget {
  id          String   @id @default(uuid())
  householdId String   @map("household_id")
  categoryId  String   @map("category_id")
  yearMonth   String   @map("year_month")
  amountPaise Int      @default(0) @map("amount_paise")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([categoryId, yearMonth])
  @@map("budgets")
}

model SinkingFund {
  id                  String         @id @default(uuid())
  householdId         String         @map("household_id")
  name                String
  openingReservePaise Int            @default(0) @map("opening_reserve_paise")
  archivedAt          DateTime?      @map("archived_at") @db.Timestamptz(6)
  movements           FundMovement[]

  @@map("sinking_funds")
}

model FundMovement {
  id           String      @id @default(uuid())
  fundId       String      @map("fund_id")
  type         String
  amountPaise  Int         @map("amount_paise")
  movementDate DateTime    @map("movement_date") @db.Timestamptz(6)
  note         String?
  fund         SinkingFund @relation(fields: [fundId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("fund_movements")
}

model SavingGoal {
  id                 String             @id @default(uuid())
  householdId        String             @map("household_id")
  bucket             String
  name               String
  targetPaise        Int?               @map("target_paise")
  monthlyBudgetPaise Int                @default(0) @map("monthly_budget_paise")
  archivedAt         DateTime?          @map("archived_at") @db.Timestamptz(6)
  contributions      GoalContribution[]

  @@map("saving_goals")
}

model GoalContribution {
  id               String     @id @default(uuid())
  goalId           String     @map("goal_id")
  amountPaise      Int        @map("amount_paise")
  contributionDate DateTime   @map("contribution_date") @db.Timestamptz(6)
  note             String?
  goal             SavingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("goal_contributions")
}

model CreditCard {
  id                       String            @id @default(uuid())
  householdId              String            @map("household_id")
  name                     String
  previousOutstandingPaise Int               @default(0) @map("previous_outstanding_paise")
  isActive                 Boolean           @default(true) @map("is_active")
  transactions             CardTransaction[]

  @@map("credit_cards")
}

model CardTransaction {
  id          String     @id @default(uuid())
  cardId      String     @map("card_id")
  txnDate     DateTime   @map("txn_date") @db.Timestamptz(6)
  description String
  amountPaise Int        @map("amount_paise")
  sNo         Int?       @map("s_no")
  card        CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("card_transactions")
}

model Receivable {
  id          String    @id @default(uuid())
  householdId String    @map("household_id")
  personName  String    @map("person_name")
  amountPaise Int       @map("amount_paise")
  status      String    @default("open")
  dueDate     DateTime? @map("due_date") @db.Timestamptz(6)
  entry_id    String?

  @@map("receivables")
}

model PlannedBill {
  id          String    @id @default(uuid())
  householdId String    @map("household_id")
  name        String
  amountPaise Int       @map("amount_paise")
  dueDate     DateTime? @map("due_date") @db.Timestamptz(6)
  isPaid      Boolean   @default(false) @map("is_paid")
  entry_id    String?

  @@map("planned_bills")
}

model ReserveLine {
  id          String @id @default(uuid())
  householdId String @map("household_id")
  yearMonth   String @map("year_month")
  name        String
  amountPaise Int    @map("amount_paise")
  source      String @default("manual")

  @@map("reserve_lines")
}

model MonthSnapshot {
  id                     String    @id @default(uuid())
  householdId            String    @map("household_id")
  yearMonth              String    @map("year_month")
  openingBalancePaise    Int       @default(0) @map("opening_balance_paise")
  lastMonthReservesPaise Int       @default(0) @map("last_month_reserves_paise")
  incomePaise            Int       @default(0) @map("income_paise")
  adjustmentsPaise       Int       @default(0) @map("adjustments_paise")
  spendingPaise          Int       @default(0) @map("spending_paise")
  protectionPaise        Int       @default(0) @map("protection_paise")
  savingPaise            Int       @default(0) @map("saving_paise")
  reservesPaise          Int       @default(0) @map("reserves_paise")
  closingBalancePaise    Int       @default(0) @map("closing_balance_paise")
  remainingPaise         Int       @default(0) @map("remaining_paise")
  status                 String    @default("open")
  closedAt               DateTime? @map("closed_at") @db.Timestamptz(6)

  @@unique([householdId, yearMonth])
  @@map("month_snapshots")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model annual_targets {
  id           String @id
  household_id String
  title        String
  target_paise Int
  type         String @default("income")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sync_queue {
  id         String    @id
  op         String
  entity     String
  entity_id  String
  payload    String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  attempts   Int       @default(0)
  synced_at  DateTime? @db.Timestamptz(6)
}
